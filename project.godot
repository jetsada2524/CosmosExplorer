; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cosmos Explorer"
config/description="Educational Space Game for Exhibition"
run/main_scene="res://scenes/attract.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.04, 0.11, 1)

[autoload]

UITheme="*res://scripts/ui_theme.gd"
GameManager="*res://scripts/game_manager.gd"
TouchInput="*res://scripts/touch_input.gd"
PlanetData="*res://scripts/planet_data.gd"
QuizManager="*res://scripts/quiz_manager.gd"
LeaderboardManager="*res://scripts/leaderboard_manager.gd"
SoundManager="*res://scripts/sound_manager.gd"
GameSettings="*res://scripts/game_settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://theme/default_theme.tres"

[input]

steer_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
]
}
steer_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
]
}
boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="obstacles"
2d_physics/layer_3="powerups"

[physics]

2d/default_gravity=0.0

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.11, 1)
